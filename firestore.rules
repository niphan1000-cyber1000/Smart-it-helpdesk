rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'niphan1000@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidStepElement(steps, idx) {
      return steps.size() <= idx || (steps[idx] is string && steps[idx].size() >= 1 && steps[idx].size() <= 600);
    }

    function isValidAiTroubleshooting(ai) {
      return ai is map
        && ai.keys().hasAll(['summary', 'steps', 'warningNote', 'source', 'triedAt'])
        && ai.keys().hasOnly(['summary', 'steps', 'warningNote', 'source', 'triedAt'])
        && ai.summary is string && ai.summary.size() <= 1000
        && ai.steps is list && ai.steps.size() >= 1 && ai.steps.size() <= 5
        && isValidStepElement(ai.steps, 0)
        && isValidStepElement(ai.steps, 1)
        && isValidStepElement(ai.steps, 2)
        && isValidStepElement(ai.steps, 3)
        && isValidStepElement(ai.steps, 4)
        && ai.warningNote is string && ai.warningNote.size() <= 600
        && ai.source in ['gemini', 'fallback']
        && ai.triedAt is string && ai.triedAt.size() <= 64;
    }

    function isValidTicket(data) {
      return data.keys().hasAll([
          'id',
          'requesterName',
          'department',
          'contactInfo',
          'category',
          'urgency',
          'description',
          'assetTag',
          'status',
          'resolutionNote',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'requesterName',
          'department',
          'contactInfo',
          'category',
          'urgency',
          'description',
          'assetTag',
          'status',
          'resolutionNote',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt',
          'completedAt',
          'aiTroubleshooting'
        ])
        && data.id is string && data.id.size() >= 3 && data.id.size() <= 32 && data.id.matches('^IT-[0-9]{4}-[0-9]{3,6}$')
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 100
        && data.department in ['บัญชี', 'การตลาด', 'บุคคล', 'ขาย', 'ไอที', 'อื่นๆ']
        && data.contactInfo is string && data.contactInfo.size() >= 1 && data.contactInfo.size() <= 120
        && data.category in [
          'คอมพิวเตอร์เปิดไม่ติด/จอดำ',
          'ลง Windows/โปรแกรมใหม่',
          'อินเทอร์เน็ต/Wi-Fi มีปัญหา',
          'ปริ้นเตอร์/สแกนเนอร์',
          'อุปกรณ์ต่อพ่วง เมาส์/คีย์บอร์ด',
          'อื่นๆ'
        ]
        && data.urgency in ['ปกติ', 'ด่วน', 'ด่วนมาก - ทำงานต่อไม่ได้']
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
        && data.assetTag is string && data.assetTag.size() <= 64
        && data.status in ['รอดำเนินการ', 'กำลังซ่อม', 'รออะไหล่', 'เสร็จสิ้น']
        && data.resolutionNote is string && data.resolutionNote.size() <= 2000
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
        && data.createdByEmail is string && data.createdByEmail.size() >= 3 && data.createdByEmail.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp)
        && (!('aiTroubleshooting' in data) || data.aiTroubleshooting == null || isValidAiTroubleshooting(data.aiTroubleshooting));
    }

    function formatSeq(n) {
      return n < 10 ? ('00' + string(n)) : (n < 100 ? ('0' + string(n)) : string(n));
    }

    function isValidCounter(data) {
      return data.keys().hasAll(['lastNumber', 'lastTicketId', 'updatedAt'])
        && data.keys().hasOnly(['lastNumber', 'lastTicketId', 'updatedAt'])
        && data.lastNumber is int
        && data.lastNumber >= 1
        && data.lastNumber <= 999999
        && data.lastTicketId is string
        && data.lastTicketId.size() >= 3
        && data.lastTicketId.size() <= 32
        && data.lastTicketId.matches('^IT-[0-9]{4}-' + formatSeq(data.lastNumber) + '$')
        && data.updatedAt is timestamp;
    }

    function isValidAiResolution(data) {
      return data.keys().hasAll(['category', 'createdByUid', 'createdAt'])
        && data.keys().hasOnly(['category', 'createdByUid', 'createdAt'])
        && data.category in [
          'คอมพิวเตอร์เปิดไม่ติด/จอดำ',
          'ลง Windows/โปรแกรมใหม่',
          'อินเทอร์เน็ต/Wi-Fi มีปัญหา',
          'ปริ้นเตอร์/สแกนเนอร์',
          'อุปกรณ์ต่อพ่วง เมาส์/คีย์บอร์ด',
          'อื่นๆ'
        ]
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'addedByUid', 'createdAt'])
        && data.keys().hasOnly(['email', 'addedByUid', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.addedByUid is string && data.addedByUid.size() >= 1 && data.addedByUid.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'targetId', 'actorUid', 'actorEmail', 'summary', 'createdAt'])
        && data.keys().hasOnly(['action', 'targetId', 'actorUid', 'actorEmail', 'summary', 'createdAt'])
        && data.action in [
          'ticket.created',
          'ticket.updated',
          'ticket.deleted',
          'ai.self_resolved',
          'admin.demo_seeded',
          'webhook.config_updated'
        ]
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    match /tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (existing().createdByUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.createdByUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && isValidId(ticketId)
        && isValidTicket(incoming())
        && incoming().id == ticketId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdByEmail == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().status == 'รอดำเนินการ' || isAdmin())
        && existsAfter(/databases/$(database)/documents/counters/tickets)
        && getAfter(/databases/$(database)/documents/counters/tickets).data.updatedAt == request.time
        && (
          getAfter(/databases/$(database)/documents/counters/tickets).data.lastTicketId == ticketId
          || isAdmin()
        );

      allow update: if isSignedIn()
        && isValidId(ticketId)
        && isValidTicket(incoming())
        && isAdmin()
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByEmail == existing().createdByEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolutionNote', 'completedAt', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(ticketId) && isAdmin();
    }

    match /counters/{counterId} {
      allow get: if isSignedIn() && counterId == 'tickets';
      allow list: if false;
      allow create: if isSignedIn()
        && counterId == 'tickets'
        && isValidCounter(incoming())
        && incoming().updatedAt == request.time
        && (
          (
            incoming().lastNumber == 1
            && !exists(/databases/$(database)/documents/tickets/$(incoming().lastTicketId))
            && existsAfter(/databases/$(database)/documents/tickets/$(incoming().lastTicketId))
            && getAfter(/databases/$(database)/documents/tickets/$(incoming().lastTicketId)).data.createdByUid == request.auth.uid
          )
          || (
            isAdmin()
            && existsAfter(/databases/$(database)/documents/tickets/$(incoming().lastTicketId))
          )
        );
      allow update: if isSignedIn()
        && counterId == 'tickets'
        && isValidCounter(incoming())
        && incoming().updatedAt == request.time
        && (
          (
            incoming().lastNumber == existing().lastNumber + 1
            && !exists(/databases/$(database)/documents/tickets/$(incoming().lastTicketId))
            && existsAfter(/databases/$(database)/documents/tickets/$(incoming().lastTicketId))
            && getAfter(/databases/$(database)/documents/tickets/$(incoming().lastTicketId)).data.createdByUid == request.auth.uid
          )
          || (
            isAdmin()
            && incoming().lastNumber >= existing().lastNumber
            && existsAfter(/databases/$(database)/documents/tickets/$(incoming().lastTicketId))
          )
        );
      allow delete: if false;
    }

    match /aiResolutions/{resolutionId} {
      allow get: if isSignedIn() && isValidId(resolutionId) && (existing().createdByUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.createdByUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && isValidId(resolutionId)
        && isValidAiResolution(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(uid)
        && isAdmin()
        && isValidAdminUser(incoming())
        && incoming().addedByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if isSignedIn() && isValidId(uid) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().actorEmail == request.auth.token.email
        && incoming().createdAt == request.time
        && (
          (
            incoming().action in ['admin.demo_seeded', 'webhook.config_updated']
            && isAdmin()
          )
          || (
            incoming().action == 'ticket.updated'
            && isAdmin()
            && isValidId(incoming().targetId)
            && existsAfter(/databases/$(database)/documents/tickets/$(incoming().targetId))
          )
          || (
            incoming().action == 'ticket.deleted'
            && isAdmin()
            && isValidId(incoming().targetId)
            && exists(/databases/$(database)/documents/tickets/$(incoming().targetId))
            && !existsAfter(/databases/$(database)/documents/tickets/$(incoming().targetId))
          )
          || (
            incoming().action == 'ticket.created'
            && isValidId(incoming().targetId)
            && !exists(/databases/$(database)/documents/tickets/$(incoming().targetId))
            && existsAfter(/databases/$(database)/documents/tickets/$(incoming().targetId))
            && getAfter(/databases/$(database)/documents/tickets/$(incoming().targetId)).data.createdByUid == request.auth.uid
          )
          || (
            incoming().action == 'ai.self_resolved'
            && isValidId(incoming().targetId)
            && !exists(/databases/$(database)/documents/aiResolutions/$(incoming().targetId))
            && existsAfter(/databases/$(database)/documents/aiResolutions/$(incoming().targetId))
            && getAfter(/databases/$(database)/documents/aiResolutions/$(incoming().targetId)).data.createdByUid == request.auth.uid
          )
        );
      allow update, delete: if false;
    }
  }
}
